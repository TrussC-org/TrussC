struct { App app; int display=0; size_t window_slots=2; sapp_window pacer{}; bool SwapIntervalEXT=false, SwapIntervalMESA=false; double refresh_period=1.0/62.0;
    _sapp_tc_window_t* windows[2]; } _sapp_tc;
