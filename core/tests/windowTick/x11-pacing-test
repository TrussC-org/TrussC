void _sapp_tc_x11_set_swapinterval(_sapp_tc_window_t*,int) {}
double _sapp_tc_now() { return clockValue; }
int XPending(int) { return eventQueued ? 1 : 0; }
void XFlush(int) {}
void XNextEvent(int, XEvent*) { eventQueued=false; }
int ConnectionNumber(int) { return 0; }
bool inputDuringWait() {
