void _sapp_tc_x11_app_event(_sapp_tc_window_t*,int) {}
RUNTIME_QUIT_HELPER
QUIT_DECISION
PERIODIC
DUE
struct _sapp_tc_x11_surface_scope {};
void _sapp_tc_timing_update(decltype(_sapp_tc_window_t::timing)* t) {
    if (_sapp_tc.windows[1] && t==&_sapp_tc.windows[1]->timing) {
        if (previousSecondary>0) minSecondaryGap=std::min(minSecondaryGap,clockValue-previousSecondary);
        previousSecondary=clockValue;
    }
    t->last=clockValue;
}
bool _sapp_tc_x11_update_dimensions(_sapp_tc_window_t*) { return false; }
bool _sapp_tc_x11_resize_surface(_sapp_tc_window_t*) { return true; }
bool _sapp_tc_x11_make_current(_sapp_tc_window_t* w) {
    // A native boundary outside swap supplies the observed main cadence.
    // No claim that this is the particular blocking boundary on the Pi.
    if (nonblocking && w==_sapp_tc.app.main) {
        nextMain+=mainPeriod;
        if (clockValue<nextMain) { clockValue=nextMain; ++mainWaits; }
    }
    return true;
}
bool sapp_tc_gl_ensure_context() { return true; }
bool _sapp_tc_native_hidden(_sapp_tc_window_t* w) { return w->desc.hidden || ((hideMain || iconMain) && w==_sapp_tc.app.main); }
bool _sapp_tc_native_iconified(_sapp_tc_window_t* w) { return iconMain && w==_sapp_tc.app.main; }
void _sapp_tc_x11_swap(_sapp_tc_window_t* w) {
    if (w==_sapp_tc.app.main) {
        clockValue+=nonblocking ? .00005 : (queued ? (w->frame_count%2 ? 0 : 2*period) : period);
        if(w->frame_count==limit) _sapp_tc.app.quit_ordered=true;
    } else {
        ++secondaryPresents;
        clockValue+=tail + period*w->swap_interval;
        if (hideAfterSecondary) hideMain=true;
    }
