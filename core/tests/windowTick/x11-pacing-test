PACE
ROLESELECT
TICK
LOOP
int main() {
    int failures=0;
    // #1012: one skipped present arms an interval-4 deadline. Input arrives
    // during the native wait. Inspect admission in that very turn, without
    // measuring elapsed real time or waiting for the old deadline to expire.
    for (int target : {0,1}) for (bool input : {false,true}) {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; secondary.win_id=2;
        main.swap_interval=main.requested_swap_interval=4; _sapp_tc.pacer={main.win_id}; // Secondaries keep their native interval-zero timer.
        clockValue=10; eventTarget=target; inputEvent=input;
        injectWait=eventQueued=eventProcessed=batchCleared=false;
        main.desc.tick_cb=secondary.desc.tick_cb=[](sapp_window h,void*) noexcept {
            _sapp_tc_lookup(h)->skip_present=true;
        };
        _sapp_tc.app.desc._tc_after_turn=[]() {
            if (eventProcessed) _sapp_tc.app.quit_ordered=true;
            else {
                injectWait=true;
                // A previous batch's marker must not wake a new non-input batch.
                for (auto* w : _sapp_tc.windows) w->input_delivered=true;
            }
        };
        _sapp_tc_x11_run_loop();
        const auto* affected=_sapp_tc.windows[target];
        const auto* other=_sapp_tc.windows[1-target];
        const bool ok=batchCleared && savedDeadline>clockValue &&
            affected->frame_count==(input ? 2 : 1) && other->frame_count==1;
        std::printf("skipped-present input admission target=%d input=%d: %s\n",target,input,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    // Count exact admission opportunities through the production loop. The
    // callback runs only on admitted ticks, so the gallery's measured fps agrees.
    for (bool timer : {false,true}) for (int interval : {1,2,3}) {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=timer?nullptr:&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=timer?nullptr:&main; main.is_main=true; main.swap_interval=1; _sapp_tc.pacer={main.win_id};
        secondary.win_id=2; secondary.requested_swap_interval=interval;
        clockValue=10; tail=0; queued=false; secondaryPresents=0; pacingOpportunities=0;
        _sapp_tc.app.desc._tc_after_turn=[]() {
            // One main presentation or due refresh timer per simulated turn.
            if (++pacingOpportunities==12) _sapp_tc.app.quit_ordered=true;
        };
        secondary.desc.tick_cb=[](sapp_window,void*) noexcept {
            const auto* s=_sapp_tc.windows[1];
            const bool sole_pacer = !_sapp_tc.app.main;
            const int expected = (s->frame_count+1)*(sole_pacer ? 1 : s->requested_swap_interval);
            if (pacingOpportunities+1!=expected) secondaryPresents=-1000;
        };
        _sapp_tc_x11_run_loop();
        const int expected = timer ? 12 : 12/interval; // Sole visible window uses native N.
        const bool ok=secondary.frame_count==expected && secondaryPresents==expected
            && (timer || main.frame_count==12);
        std::printf("requested interval=%d timer=%d main=%d ticks=%d presents=%d: %s\n",
            interval,timer,main.frame_count,secondary.frame_count,secondaryPresents,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    // Losing the old pacer promotes the remaining visible follower at native N.
    // The partially spent follower counter must not also divide that native N.
    {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; main.swap_interval=1; _sapp_tc.pacer={main.win_id};
        secondary.win_id=2; secondary.requested_swap_interval=2;
        clockValue=10; secondaryPresents=0;
        _sapp_tc.app.desc._tc_after_turn=[]() {
            if (_sapp_tc.app.main) { _sapp_tc.app.main=nullptr; _sapp_tc.windows[0]=nullptr; }
            else _sapp_tc.app.quit_ordered=true;
        };
        _sapp_tc_x11_run_loop();
        const bool ok=main.frame_count==1 && secondary.frame_count==1 && secondaryPresents==1
            && secondary.swap_interval==2 && _sapp_tc.pacer.id==2;
        std::printf("interval count hands off to native N once: %s\n",ok?"PASS":"FAIL");
        failures+=!ok;
    }
    for (bool burst : {false, true}) for (double work : {0.0, .0001, .001}) {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; secondary.win_id=2; main.swap_interval=1; _sapp_tc.pacer={main.win_id}; clockValue=10; tail=work; queued=burst;
        _sapp_tc_x11_run_loop();
        // Steady swaps should admit almost every tick. Queued EGL swaps may
        // teach the existing estimator a doubled period, so allow half cadence.
        bool ok=secondary.frame_count*4>=main.frame_count*3;
#if defined(SOKOL_GLES3)
        if (burst) ok=secondary.frame_count*2>=main.frame_count-4;
#endif
        std::printf("relative cadence queued=%d work=%.4f main=%d secondary=%d refresh_ms=%.3f: %s\n",burst,work,main.frame_count,secondary.frame_count,_sapp_tc.refresh_period*1000,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    // Main ticks at P<R, with its swap returning in 0.05ms. The secondary
    // starts eps after a main tick and completion work spans that eps.
    // Light callback work exposes startup admission misses. A refresh of
    // non-swap callback work also makes completion skip the following deadline,
    // reproducing sustained half cadence despite both swaps returning quickly.
    for (bool heavy : {false,true}) for (bool lower : {false,true}) {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; secondary.win_id=2; main.swap_interval=1; _sapp_tc.pacer={main.win_id};
        clockValue=nextMain=10; mainPeriod=period-.0001;
        main.last_present=10; secondary.earliest_next=10+mainPeriod+.0001;
        nonblocking=true; queued=false; tail=heavy?.00005:.0002; callbackWork=heavy?period:0;
        previousSecondary=0; minSecondaryGap=100; mainWaits=0;
        secondaryDraws=0; previousDrawTick=10; drawAccumulator=0;
        secondary.desc.tick_cb=lower?lowerFps:renderWork;
        _sapp_tc_x11_run_loop();
        const double expectedDraws=(clockValue-10)*20;
        bool ok=secondary.frame_count==main.frame_count
            && minSecondaryGap>period*.5 && (heavy || mainWaits>=limit-1);
        if(lower) ok=ok && std::abs(secondaryDraws-expectedDraws)<=2;
        std::printf("phase lock nonblocking P=R-0.1ms callback_work_R=%d lower_fps=%d main=%d secondary=%d draws=%d gap_ms=%.3f: %s\n",
            heavy,lower,main.frame_count,secondary.frame_count,secondaryDraws,minSecondaryGap*1000,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    callbackWork=0;
    // A fast main whose interval-positive swaps do not actually pace the
    // loop must leave the secondary on its refresh timer.
    {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; secondary.win_id=2; main.swap_interval=1; _sapp_tc.pacer={main.win_id}; main.last_present=10;
        clockValue=nextMain=10; mainPeriod=.001; tail=0;
        previousSecondary=0; minSecondaryGap=100;
        _sapp_tc_x11_run_loop();
        bool ok=secondary.frame_count<main.frame_count*.75 && minSecondaryGap>=period*.5;
#if defined(SOKOL_GLES3)
        ok=ok && std::abs(secondary.frame_count-(clockValue-10)/period)<=2;
#endif
        // GLX supplies its own periodic wait when swaps return immediately;
        // its estimator may change R. EGL leaves main due and tests a truly
        // unpaced main. Both must avoid promoting every fast pass to a tick.
        std::printf("unpaced main retains timer main=%d secondary=%d elapsed_ms=%.3f R_ms=%.3f min_gap_ms=%.3f: %s\n",main.frame_count,secondary.frame_count,(clockValue-10)*1000,_sapp_tc.refresh_period*1000,minSecondaryGap*1000,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    // #998: a main window throttled to half the display rate (setFps(30) on a
    // 60 Hz display: every other tick skips its present, the skipped ticks stay
    // timer-paced) presents every ~2R with a non-blocking swap. That interval
    // must not teach the estimate a 30 Hz display, and after the main returns to
    // VSYNC the secondary must keep the display rate. A poisoned estimate
    // (seeded at 30 Hz) must also converge back once the main presents at VSYNC.
    for (bool seeded : {false,true}) {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; secondary.win_id=2; main.swap_interval=1; _sapp_tc.pacer={main.win_id}; main.last_present=10;
        _sapp_tc.refresh_period=seeded ? 1.0/30 : period;
        clockValue=nextMain=10; mainPeriod=period; tail=0; nonblocking=true; queued=false;
        seeded_run=seeded; previousSecondary=0; minSecondaryGap=100; throttledRefresh=0; switchTime=0; switchSecondary=0;
        main.desc.tick_cb=[](sapp_window,void*) noexcept {
            auto* m=_sapp_tc.windows[0];
            if (m->frame_count==300) {
                throttledRefresh=_sapp_tc.refresh_period; switchTime=clockValue; switchSecondary=_sapp_tc.windows[1]->frame_count;
            }
            if (!seeded_run && m->frame_count<300 && m->frame_count%2) m->skip_present=true;
        };
        _sapp_tc_x11_run_loop();
        const double rate=(secondary.frame_count-switchSecondary)/(clockValue-switchTime);
        bool ok=std::abs(throttledRefresh-period)<period*.02 && std::abs(_sapp_tc.refresh_period-period)<period*.02
            && std::abs(rate*period-1)<.03;
        std::printf("throttled main keeps display estimate seeded=%d throttled_R_ms=%.3f R_ms=%.3f secondary_hz=%.2f (display %.2f): %s\n",
            seeded,throttledRefresh*1000,_sapp_tc.refresh_period*1000,rate,1/period,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    // The former follower is promoted and immediately due after main hides.
    // One transition callback can share the previous tick's timestamp; its
    // native interval now paces the next present instead of the old timer.
    {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=&main; main.is_main=true; secondary.win_id=2; main.swap_interval=1; _sapp_tc.pacer={main.win_id}; main.last_present=10;
        main.draw_while_hidden=false;
        clockValue=nextMain=10; mainPeriod=period; tail=0;
        secondary.earliest_next=10+.25*period+.00005;
        previousSecondary=0; minSecondaryGap=100; hideAfterSecondary=true;
        secondary.desc.tick_cb=[](sapp_window,void*) noexcept {
            if (_sapp_tc.windows[1]->frame_count==1) _sapp_tc.app.quit_ordered=true;
        };
        _sapp_tc_x11_run_loop();
        bool ok=secondary.frame_count==2 && _sapp_tc.pacer.id==secondary.win_id && secondary.swap_interval==1;
        std::printf("main-to-visible-pacer handoff secondary=%d transition_gap_ms=%.3f: %s\n",secondary.frame_count,minSecondaryGap*1000,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    hideAfterSecondary=hideMain=false;
    nonblocking=false;
    // Hidden/iconified main uses timers; it must not gate the secondary.
    for (bool absent : {false,true}) for (bool iconify : {false,true}) for (bool lower : {false,true}) {
        _sapp_tc_window_t main{}, secondary{};
        _sapp_tc={}; _sapp_tc.windows[0]=absent?nullptr:&main; _sapp_tc.windows[1]=&secondary;
        _sapp_tc.app.main=absent?nullptr:&main; main.is_main=true; secondary.win_id=2; main.swap_interval=1; _sapp_tc.pacer={main.win_id}; main.draw_while_hidden=false;
        clockValue=10; hideMain=!iconify; iconMain=iconify; tail=0;
        previousSecondary=0; minSecondaryGap=100;
        secondaryDraws=0; previousDrawTick=10; drawAccumulator=0;
        secondary.desc.tick_cb=[](sapp_window,void*) noexcept {
            if (_sapp_tc.windows[1]->frame_count==limit-1) _sapp_tc.app.quit_ordered=true;
        };
        if (lower) secondary.desc.tick_cb=lowerFps;
        _sapp_tc_x11_run_loop();
        bool ok=secondary.frame_count==limit && std::abs((clockValue-10)-(limit-1)*period)<.7;
        if (lower) ok=ok && std::abs(secondaryDraws-(clockValue-10)*20)<=2;
        std::printf("timer fallback absent_main=%d iconified=%d lower_fps=%d secondary=%d draws=%d: %s\n",absent,iconify,lower,secondary.frame_count,secondaryDraws,ok?"PASS":"FAIL");
        failures+=!ok;
    }
    hideMain=iconMain=false;
    // A late callback must retain phase and skip elapsed deadlines in one step.
    _sapp_tc_window_t window{}; window.earliest_next=10;
    clockValue=10+3.2*period;
    _sapp_tc_x11_pace_periodic(&window,period);
    bool ok=std::abs(window.earliest_next-(10+4*period))<1e-9;
    std::printf("late periodic phase: %s\n",ok?"PASS":"FAIL"); failures+=!ok;
    // Floating-point rounding must not leave a skipped deadline due at once.
    window.earliest_next=10+1.0/60.0; clockValue=20;
    _sapp_tc_x11_pace_periodic(&window,1.0/60.0);
    ok=window.earliest_next>20 && !_sapp_tc_x11_window_due(&window,20);
    std::printf("exact-boundary skip stays future: %s\n",ok?"PASS":"FAIL"); failures+=!ok;
    window.earliest_next=100; clockValue=10;
    _sapp_tc_x11_pace_periodic(&window,period);
    ok=std::abs(window.earliest_next-(10+period))<1e-9;
    std::printf("future deadline resync: %s\n",ok?"PASS":"FAIL"); failures+=!ok;
    return failures?1:0;
