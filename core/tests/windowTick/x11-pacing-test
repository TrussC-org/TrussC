    // event-converter-test. Exercise the real loop's clearing/reset and due-check.
    auto* w=_sapp_tc.windows[eventTarget];
    batchCleared=!w->input_delivered;
    savedDeadline=w->earliest_next;
    if (inputEvent) w->input_delivered=true;
