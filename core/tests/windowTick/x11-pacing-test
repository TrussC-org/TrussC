    (scratch / 'mutant.cpp').write_text(mutant, encoding='utf-8')
    subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++20', '-O1', '-DSOKOL_GLCORE',
                    str(scratch/'mutant.cpp'), '-o', str(scratch/'mutant')], check=True)
    result = subprocess.run([str(scratch/'mutant')], capture_output=True, text=True, timeout=20)
    detected = result.returncode == 1 and 'skipped-present input admission target=0 input=1: FAIL' in result.stdout
    print('GLX missing deadline reset mutation: ' + ('detected' if detected else 'NOT DETECTED'), flush=True)
    failed |= not detected
    raise SystemExit(int(failed))
