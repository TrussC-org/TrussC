#!/bin/sh
# Compile the complete production loop with deterministic native boundaries.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/tc-egl-wait.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
wraps='clock_gettime XPending XFlush XNextEvent XGetWindowAttributes poll eglMakeCurrent eglGetCurrentContext eglGetCurrentSurface eglGetCurrentDisplay eglSwapBuffers XGrabPointer XUngrabPointer XWarpPointer XSetSelectionOwner XGetSelectionOwner XInternAtom XConvertSelection XDeleteProperty XCheckTypedWindowEvent XGetWindowProperty'
set --
for name in $wraps; do set -- "$@" "-Wl,--wrap=$name"; done
"${CXX:-c++}" -std=c++20 -O1 -DSOKOL_GLES3 -I"${TC_X11_TEST_INCLUDE:-$root/core/include/sokol}" \
    "$root/core/tests/windowTick/x11-regression.cpp" "$@" -lX11 -lXcursor -lXi -lEGL -lGLESv2 -o "$scratch/probe"
"$scratch/probe"
