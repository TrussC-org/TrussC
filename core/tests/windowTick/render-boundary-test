#!/bin/sh
# Build after the capped core sweep, through tcbuild.sh. EGL/Mesa only.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/tc-render-boundary.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
python3 - "$root" "$scratch" <<'PY'
from pathlib import Path
import shlex, subprocess, sys, os
root, scratch = map(Path, sys.argv[1:])
flags = []
for line in (root/'core/build-linux/CMakeFiles/TrussC.dir/flags.make').read_text().splitlines():
    if line.startswith(('CXX_DEFINES =','CXX_INCLUDES =')): flags += shlex.split(line.split('=',1)[1])
link = shlex.split((root/'core/tests/allCoreTests/build-linux/CMakeFiles/allCoreTests.dir/link.txt').read_text())
libs = link[link.index('-o')+2:]
libs = [x for x in libs if not x.endswith('.o') and x != '-Wl,--wrap=malloc']
# An optional include root makes copied-source mutations reproducible.
inc = os.environ.get('TC_RENDER_TEST_INCLUDE', str(root/'core/include'))
objects = [os.environ['TC_RENDER_TEST_CORE_OBJECT']] if os.environ.get('TC_RENDER_TEST_CORE_OBJECT') else []
cmd = ['c++','-std=c++20','-O0','-g0','-DNDEBUG','-I'+inc]+flags+[str(root/'core/tests/windowTick/render-boundary.cpp'),'-o',str(scratch/'probe')]+objects+libs+['-lEGL']
subprocess.run(cmd, cwd=root, check=True)
subprocess.run([str(scratch/'probe')], cwd=root, env=dict(os.environ, EGL_PLATFORM='surfaceless', LIBGL_ALWAYS_SOFTWARE='1'), check=True)
PY
