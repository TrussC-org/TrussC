#!/bin/sh
# Build after the capped core sweep, through tcbuild.sh. EGL/Mesa only.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/tc-render-boundary.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
python3 - "$root" "$scratch" <<'PY'
from pathlib import Path
import shlex, subprocess, sys, os, re
root, scratch = map(Path, sys.argv[1:])
flags = []
build = Path(os.environ.get('TC_RENDER_TEST_BUILD', root/'core/build-linux'))
for line in (build/'CMakeFiles/TrussC.dir/flags.make').read_text(encoding='utf-8').splitlines():
    if line.startswith(('CXX_DEFINES =','CXX_INCLUDES =')): flags += shlex.split(line.split('=',1)[1])
link = shlex.split((root/'core/tests/allCoreTests/build-linux/CMakeFiles/allCoreTests.dir/link.txt').read_text())
libs = link[link.index('-o')+2:]
libs = [x for x in libs if not x.endswith('.o') and x != '-Wl,--wrap=malloc']
if os.environ.get('TC_RENDER_TEST_ARCHIVE'):
    libs = [os.environ['TC_RENDER_TEST_ARCHIVE'] if x.endswith('libTrussC.a') else x for x in libs]
if '-DSOKOL_GLES3' in flags:
    libs = [x for x in libs if x != '-lGL'] + ['-lGLESv2']
# An optional include root makes copied-source mutations reproducible.
inc = os.environ.get('TC_RENDER_TEST_INCLUDE', str(root/'core/include'))
pool_settings = re.findall(r'sgdesc\.(\w+_pool_size) = (\d+);', (root/'core/include/tc/app/tcGlobal.cpp').read_text())
assert pool_settings, 'production GPU pool settings not found'
(scratch/'gpu-pools.inc').write_text(''.join(f'gd.{field} = {value};\n' for field, value in pool_settings))
objects = [os.environ['TC_RENDER_TEST_CORE_OBJECT']] if os.environ.get('TC_RENDER_TEST_CORE_OBJECT') else []
cmd = ['c++','-std=c++20','-O0','-g0','-DNDEBUG','-I'+inc,'-I'+str(scratch)]+flags+[str(root/'core/tests/windowTick/render-boundary.cpp'),'-o',str(scratch/'probe')]+objects+libs+['-lEGL']
subprocess.run(cmd, cwd=root, check=True)
result = subprocess.run([str(scratch/'probe')], cwd=root, env=dict(os.environ, EGL_PLATFORM='surfaceless', LIBGL_ALWAYS_SOFTWARE='1'), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
print(result.stdout, end='')
assert 're-rendered' not in result.stdout, 'unexpected same-recording FBO revision notice'
assert '[ERROR]' not in result.stdout, 'GPU probe reported a rendering error'
result.check_returncode()
PY
