    result=dict(name=name,returncode=r.returncode,failed_assertions=failed,valid=valid)
    print(result,flush=True)
    snapshots=OUT/'sources'/name;snapshots.mkdir(parents=True,exist_ok=True)
    for path in work.rglob('*'):
