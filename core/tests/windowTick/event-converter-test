        for k,p in paths.items():
            selected[k]=work/(name+'-'+k+'.o');compile(p,selected[k],overlay)
    elif kind=='pair':
        for k,body in zip(['runtime','mcp'],source):
            path=work/(name+'-'+k+'.cpp');path.write_text(body,encoding='utf-8')
            selected[k]=work/(name+'-'+k+'.o');compile(path,selected[k])
    elif kind:
        path=work/(name+'.cpp');path.write_text(source,encoding='utf-8');obj=work/(name+'.o');compile(path,obj);selected[kind]=obj
