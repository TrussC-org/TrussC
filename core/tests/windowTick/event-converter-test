    elif kind in ('node','app'):
        overlay=work/(name+'-include');overlay.mkdir(exist_ok=True)
        for header in ['TrussC.h','tcBaseApp.h','tcNode.h']:
            (overlay/header).write_text((ROOT/'core/include'/header).read_text(encoding='utf-8'),encoding='utf-8')
        (overlay/('tcNode.h' if kind=='node' else 'tcBaseApp.h')).write_text(source,encoding='utf-8')
