    with (OUT/(name+'.log')).open('w',encoding='utf-8') as log:r=subprocess.run([str(binary)],stdout=log,stderr=subprocess.STDOUT,timeout=30,env=dict(os.environ,TRUSSC_MCP='0'))
    text=(OUT/(name+'.log')).read_text(encoding='utf-8');failed=text.count('host-entry: FAIL:')
