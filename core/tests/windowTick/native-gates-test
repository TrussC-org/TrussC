#!/bin/sh
# Compile production desktop gates/policy with native API seams; no display needed.
# TC_NATIVE_GATES_INCLUDE may name a private sokol header directory for mutations.
# Pass --mutations to check private-header regressions and missing markers too.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/tc-native-gates.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
python3 - "$root" "$scratch" "$@" <<'PY'
from pathlib import Path
import os, subprocess, sys
root, scratch = map(Path, sys.argv[1:3])
if sys.argv[3:] not in ([], ['--mutations']):
    sys.exit('Usage: native-gates-test [--mutations]')
include = Path(os.environ.get('TC_NATIVE_GATES_INCLUDE', root/'core/include/sokol'))

def fail(message):
    sys.exit('native-gates: ' + message)

def read(path):
    try:
        return path.read_text()
    except OSError as error:
        fail(str(error))

def position(text, marker, origin):
    start = text.find(marker)
    if start < 0:
        fail(f'{origin}: missing extraction marker {marker!r}')
    return start

def body(text, marker, origin):
    start = position(text, marker, origin)
    opening = text.find('{', start)
    if opening < 0:
        fail(f'{origin}: no opening brace for marker {marker!r}')
    depth, end = 1, opening + 1
    while depth and end < len(text):
        depth += (text[end] == '{') - (text[end] == '}')
        end += 1
    if depth:
        fail(f'{origin}: unbalanced braces for marker {marker!r}')
    return text[start:end]

native = read(include/'sokol_app_tc.h')
shared = read(include/'util/sokol_window_native.h')
common = read(root/'core/include/tc/app/tcGlobal.cpp')
extraction_markers = []
def extract(marker):
    extraction_markers.append(marker)
    return body(native, marker, 'sokol_app_tc.h') + '\n'

def mac_extract(marker, seams=()):
    # Translate only Objective-C syntax/API calls; keep production control flow.
    # Every seam is required, so upstream changes cannot silently empty a probe.
    text = extract(marker)
    for old, new in seams:
        extraction_markers.append(old)
        position(text, old, 'sokol_app_tc.h: ' + marker)
        text = text.replace(old, new)
    return text

