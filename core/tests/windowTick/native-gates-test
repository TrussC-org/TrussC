# Compile production desktop gates/policy with native API seams; no display needed.
# TC_NATIVE_GATES_INCLUDE may name a private sokol header directory for mutations.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/tc-native-gates.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
python3 - "$root" "$scratch" <<'PY'
from pathlib import Path
import os, subprocess, sys
root, scratch = map(Path, sys.argv[1:])
include = Path(os.environ.get('TC_NATIVE_GATES_INCLUDE', root/'core/include/sokol'))

def fail(message):
    sys.exit('native-gates: ' + message)

def read(path):
    try:
        return path.read_text()
    except OSError as error:
        fail(str(error))

def position(text, marker, origin):
    start = text.find(marker)
    if start < 0:
        fail(f'{origin}: missing extraction marker {marker!r}')
    return start

def body(text, marker, origin):
    start = position(text, marker, origin)
    opening = text.find('{', start)
    if opening < 0:
        fail(f'{origin}: no opening brace for marker {marker!r}')
    depth, end = 1, opening + 1
    while depth and end < len(text):
        depth += (text[end] == '{') - (text[end] == '}')
        end += 1
    if depth:
        fail(f'{origin}: unbalanced braces for marker {marker!r}')
    return text[start:end]

native = read(include/'sokol_app_tc.h')
shared = read(include/'util/sokol_window_native.h')
common = read(root/'core/include/tc/app/tcGlobal.cpp')
def extract(marker):
    return body(native, marker, 'sokol_app_tc.h') + '\n'
policy = body(common, 'static bool occlusionPausesUpdate(', 'tcGlobal.cpp')
helpers = '\n'.join(body(shared, 'static inline bool '+name+'(', 'sokol_window_native.h')
                  for name in ('_sapp_tc_native_iconified', '_sapp_tc_native_occluded', '_sapp_tc_native_hidden'))

# Keep the adapter contract: update-only policy dispatch precedes size/drawable
# admission on each desktop OS. These are source checks, not native adapter runs.
for adapter in ('mac/tcWindowMac.mm', 'win/tcWindowWin.cpp', 'linux/tcWindowLinux.cpp'):
    text = body(read(root/'core/platform'/adapter), 'void windowTickImpl(', adapter)
    marker = 'if (sapp_window_occluded(swin)) {'
    gate = body(text, marker, adapter)
    if not ('false, nullptr, true)' in gate and 'internal::runWindowTick(' in gate
            and position(text, marker, adapter) < position(text, 'if (fbw <= 0', adapter)):
        fail(f'{adapter}: update-only policy must precede framebuffer admission')
print('native-gates: desktop adapters dispatch gated policy before size admission: PASS', flush=True)

