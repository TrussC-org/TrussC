#!/usr/bin/env python3
"""Production-linked DPI 2 seam, as in windowState/pre-window-test.

Run through tcbuild.sh after building allCoreTests. The test uses its build flags
and native-DPI link seam, retaining real Font/Image/SoundBuffer implementations.
TC_RESOURCE_DPI_SOURCE optionally selects the baseline graphics source.
"""
from pathlib import Path
import json
import os
import shlex
import subprocess
import tempfile

root = Path(__file__).resolve().parents[3]
build = root / 'core/tests/allCoreTests/build-linux'
entries = json.loads((build / 'compile_commands.json').read_text(encoding='utf-8'))
entry = next(e for e in entries if e['file'].endswith('/tcResourceLoadGraphics.cpp'))
args = shlex.split(entry['command'])
compiler = os.environ.get('CXX', args.pop(0))
flags = []
skip = False
for arg in args:
    if skip:
        skip = False
        continue
    if arg == '-o':
        skip = True
        continue
    if arg == '-c' or arg.endswith('/tcResourceLoadGraphics.cpp') or arg.startswith(('-O', '-g')):
        continue
    flags.append(arg)
flags += ['-O0', '-g0']
link = shlex.split((build / 'CMakeFiles/allCoreTests.dir/link.txt').read_text(encoding='utf-8'))
libs = link[next(i for i, arg in enumerate(link) if arg.endswith('libTrussC.a')):]
with tempfile.TemporaryDirectory(prefix='tc-resource-dpi-') as temporary:
    scratch = Path(temporary)
    seam = scratch / 'native.cpp'
    seam.write_text('extern "C" float __wrap_sapp_dpi_scale() { return 2.f; }\n', encoding='utf-8')
    sources = {'test': root / 'core/tests/asyncLoads/src/main.cpp', 'native': seam,
               'graphics': Path(os.environ.get('TC_RESOURCE_DPI_SOURCE', entry['file']))}
    objects = []
    for name, source in sources.items():
        obj = scratch / (name + '.o')
        subprocess.run([compiler, *flags, '-c', str(source), '-o', str(obj)], check=True)
        objects.append(str(obj))
    binary = scratch / 'dpi-repro'
    subprocess.run([compiler, *objects, '-Wl,--wrap=sapp_dpi_scale', *libs, '-o', str(binary)], check=True)
    print('Native DPI seam: 2; requesting DPI: 1 and 2; completion: process DPI 1', flush=True)
    raise SystemExit(subprocess.run([str(binary), '--dpi-repro'], cwd=scratch, timeout=180,
                                   env=dict(os.environ, TRUSSC_MCP='0')).returncode)
