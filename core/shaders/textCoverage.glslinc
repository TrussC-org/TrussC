// Shared by immediate and retained glyph rendering.
@block text_coverage
float textCoverage(vec2 texcoord) {
    // Half gradients keep base-only sampling through two atlas texels per target
    // pixel, then increase LOD continuously (the "one level sharp" policy).
    //
    // Minified text (more than one atlas texel per pixel) also takes a 4-tap
    // rotated-grid supersample (RGSS) over the pixel footprint: the same as
    // rendering at 2x and box-averaging down, per text fragment only. Offsets
    // are in target pixels; every tap has a distinct x and a distinct y
    // (+-0.125, +-0.375), so with the neighboring pixels the taps sit evenly
    // every 1/4 pixel along both axes and a moving stroke no longer pops in and
    // out of the single sample. At 1:1 and magnified the spread is 0: the exact
    // single sample is kept, so grid-fitted 1:1 text still lands texel on pixel.
    // Once minified it opens fully within 1/8 texel per pixel (by 1.125): a
    // partly open spread leaves gaps between the taps, and a slow fade made
    // ~1.5x minification shimmer more than full supersampling does.
    // Derivatives stay unconditional (outside the branch).
    vec2 dx = dFdx(texcoord);
    vec2 dy = dFdy(texcoord);
    vec2 gx = dx * 0.5;
    vec2 gy = dy * 0.5;
    vec2 size = vec2(textureSize(sampler2D(tex, smp), 0));
    float texelsPerPixel = max(length(dx * size), length(dy * size));
    float spread = clamp((texelsPerPixel - 1.0) * 8.0, 0.0, 1.0);
    // Keep one initialized result and return path for D3D11 (X4000).
    float coverage = 0.0;
    if (spread <= 0.0) {
        coverage = textureGrad(sampler2D(tex, smp), texcoord, gx, gy).r;
    } else {
        vec2 ox = dx * spread;
        vec2 oy = dy * spread;
        float c = 0.0;
        c += textureGrad(sampler2D(tex, smp), texcoord + ox *  0.375 + oy *  0.125, gx, gy).r;
        c += textureGrad(sampler2D(tex, smp), texcoord + ox *  0.125 + oy * -0.375, gx, gy).r;
        c += textureGrad(sampler2D(tex, smp), texcoord + ox * -0.375 + oy * -0.125, gx, gy).r;
        c += textureGrad(sampler2D(tex, smp), texcoord + ox * -0.125 + oy *  0.375, gx, gy).r;
        coverage = c * 0.25;
    }
    return coverage;
}
@end
