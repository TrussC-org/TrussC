// Shared by immediate and retained glyph rendering.
@block text_coverage
// Experimental top level. Rebuild both consuming shaders after changing this.
// Compile-time experiments; defaults retain the existing branch output.
#ifndef TC_TEXT_PATTERN
#define TC_TEXT_PATTERN 0 // 0: msaa, 1: nested, 2: nested five-point candidate, 3: C4 nested
#endif
#ifndef TC_TEXT_OPENING
#define TC_TEXT_OPENING 0 // 0: blend, 1: main RGSS spread (msaa only)
#endif
#ifndef TC_TEXT_TAPS
#define TC_TEXT_TAPS 8
#endif
#if TC_TEXT_OPENING == 1 && TC_TEXT_PATTERN != 0
#error Spread opening requires the main MSAA RGSS pattern.
#endif

#if TC_TEXT_PATTERN == 0
#if TC_TEXT_OPENING == 1
float textCoverageSpread(vec2 texcoord) {
    // Half gradients keep base-only sampling through two atlas texels per target
    // pixel, then increase LOD continuously (the "one level sharp" policy).
    //
    // Minified text (more than one atlas texel per pixel) also takes a 4-tap
    // rotated-grid supersample (RGSS) over the pixel footprint: the same as
    // rendering at 2x and box-averaging down, per text fragment only. Offsets
    // are in target pixels; every tap has a distinct x and a distinct y
    // (+-0.125, +-0.375), so with the neighboring pixels the taps sit evenly
    // every 1/4 pixel along both axes and a moving stroke no longer pops in and
    // out of the single sample. At 1:1 and magnified the spread is 0: the exact
    // single sample is kept, so grid-fitted 1:1 text still lands texel on pixel.
    // Once minified it opens fully within 1/8 texel per pixel (by 1.125): a
    // partly open spread leaves gaps between the taps, and a slow fade made
    // ~1.5x minification shimmer more than full supersampling does.
    // Derivatives stay unconditional (outside the branch).
    vec2 dx = dFdx(texcoord);
    vec2 dy = dFdy(texcoord);
    vec2 gx = dx * 0.5;
    vec2 gy = dy * 0.5;
    vec2 size = vec2(textureSize(sampler2D(tex, smp), 0));
    float texelsPerPixel = max(length(dx * size), length(dy * size));
    float spread = clamp((texelsPerPixel - 1.0) * 8.0, 0.0, 1.0);
    if (spread <= 0.0) return textureGrad(sampler2D(tex, smp), texcoord, gx, gy).r;
    vec2 ox = dx * spread;
    vec2 oy = dy * spread;
    float c = 0.0;
    c += textureGrad(sampler2D(tex, smp), texcoord + ox *  0.375 + oy *  0.125, gx, gy).r;
    c += textureGrad(sampler2D(tex, smp), texcoord + ox *  0.125 + oy * -0.375, gx, gy).r;
    c += textureGrad(sampler2D(tex, smp), texcoord + ox * -0.375 + oy * -0.125, gx, gy).r;
    c += textureGrad(sampler2D(tex, smp), texcoord + ox * -0.125 + oy *  0.375, gx, gy).r;
    return c * 0.25;
}
#endif
#if TC_TEXT_TAPS != 8 && TC_TEXT_TAPS != 16
#error TC_TEXT_TAPS must be 8 or 16.
#endif
const vec2 textOffsets1[1] = vec2[1](vec2(0.0));
const vec2 textOffsets4[4] = vec2[4](
    vec2(0.375, 0.125), vec2(0.125, -0.375),
    vec2(-0.375, -0.125), vec2(-0.125, 0.375));
// Standard 8x positions, center-relative and y flipped to match the RGSS above.
const vec2 textOffsets8[8] = vec2[8](
    vec2(1.0, 3.0) / 16.0, vec2(-1.0, -3.0) / 16.0,
    vec2(5.0, -1.0) / 16.0, vec2(-3.0, 5.0) / 16.0,
    vec2(-5.0, -5.0) / 16.0, vec2(-7.0, 1.0) / 16.0,
    vec2(3.0, -7.0) / 16.0, vec2(7.0, 7.0) / 16.0);
// Standard 16x positions shifted by +1/32 pixel on both axes, then y flipped.
#if TC_TEXT_TAPS == 16
const vec2 textOffsets16[16] = vec2[16](
    vec2(1.5, -1.5) / 16.0, vec2(-0.5, 2.5) / 16.0,
    vec2(-2.5, -2.5) / 16.0, vec2(4.5, 0.5) / 16.0,
    vec2(-4.5, 1.5) / 16.0, vec2(2.5, -5.5) / 16.0,
    vec2(5.5, -3.5) / 16.0, vec2(3.5, 4.5) / 16.0,
    vec2(-1.5, -6.5) / 16.0, vec2(0.5, 6.5) / 16.0,
    vec2(-3.5, 5.5) / 16.0, vec2(-5.5, -4.5) / 16.0,
    vec2(-7.5, -0.5) / 16.0, vec2(7.5, 3.5) / 16.0,
    vec2(6.5, -7.5) / 16.0, vec2(-6.5, 7.5) / 16.0);
#endif
// Half gradients reach the font sampler's mip-4 cap at 32 texels/pixel.
#if TC_TEXT_TAPS == 16
const int textTransitionCount = 3;
const float textThresholds[3] = float[3](1.0, 32.0, 64.0);
#else
const int textTransitionCount = 2;
const float textThresholds[2] = float[2](1.0, 32.0);
#endif

float textCoverageLevel(int level, vec2 uv, vec2 dx, vec2 dy) {
    vec2 gx = dx * 0.5;
    vec2 gy = dy * 0.5;
    if (level == 0) {
        return textureGrad(sampler2D(tex, smp), uv + textOffsets1[0], gx, gy).r;
    }
    float coverage = 0.0;
    if (level == 1) {
        for (int i = 0; i < 4; ++i) {
            vec2 offset = textOffsets4[i];
            coverage += textureGrad(sampler2D(tex, smp), uv + dx * offset.x + dy * offset.y, gx, gy).r;
        }
        return coverage * 0.25;
    }
#if TC_TEXT_TAPS == 16
    if (level == 3) {
        for (int i = 0; i < 16; ++i) {
            vec2 offset = textOffsets16[i];
            coverage += textureGrad(sampler2D(tex, smp), uv + dx * offset.x + dy * offset.y, gx, gy).r;
        }
        return coverage / 16.0;
    }
#endif
    for (int i = 0; i < 8; ++i) {
        vec2 offset = textOffsets8[i];
        coverage += textureGrad(sampler2D(tex, smp), uv + dx * offset.x + dy * offset.y, gx, gy).r;
    }
    return coverage / 8.0;
}

float textCoverage(vec2 texcoord) {
    #if TC_TEXT_OPENING == 1
    vec2 openingDx = dFdx(texcoord);
    vec2 openingDy = dFdy(texcoord);
    vec2 openingSize = vec2(textureSize(sampler2D(tex, smp), 0));
    if (max(length(openingDx * openingSize), length(openingDy * openingSize)) < 1.125) return textCoverageSpread(texcoord);
    #endif
    // Derivatives stay unconditional. At 1:1 and magnified, keep the exact
    // single sample. Every transition blends fixed footprints over 12.5%
    // in linear texels/pixel (threshold through threshold * 1.125).
    vec2 dx = dFdx(texcoord);
    vec2 dy = dFdy(texcoord);
    vec2 size = vec2(textureSize(sampler2D(tex, smp), 0));
    float texelsPerPixel = max(length(dx * size), length(dy * size));
    for (int level = 0; level < textTransitionCount; ++level) {
        float threshold = textThresholds[level];
        if (texelsPerPixel < threshold * 1.125) {
            float low = textCoverageLevel(level, texcoord, dx, dy);
            float t = clamp((texelsPerPixel / threshold - 1.0) * 8.0, 0.0, 1.0);
            if (t <= 0.0) return low;
            float high = textCoverageLevel(level + 1, texcoord, dx, dy);
            return mix(low, high, t);
        }
    }
    return textCoverageLevel(textTransitionCount, texcoord, dx, dy);
}
#elif TC_TEXT_PATTERN == 3
#ifndef TC_TEXT_TOP
#define TC_TEXT_TOP 33
#endif
#if TC_TEXT_TOP != 17 && TC_TEXT_TOP != 33
#error TC_TEXT_TOP must be 17 or 33 for the C4 pattern.
#endif
// Pattern 3 schedules: 0 staggered (existing output), 1 A, 2 B.
#ifndef TC_TEXT_C4_SCHEDULE
#define TC_TEXT_C4_SCHEDULE 0
#endif
#if TC_TEXT_C4_SCHEDULE < 0 || TC_TEXT_C4_SCHEDULE > 2
#error TC_TEXT_C4_SCHEDULE must be 0 (staggered), 1 (A), or 2 (B).
#endif
// Owner's center-relative target-pixel table, Y down; sampling flips Y.
const vec2 textC4Offsets[] = vec2[](
    vec2(0.000, 0.000),
    vec2(0.400, 0.200), vec2(-0.200, 0.400), vec2(-0.400, -0.200), vec2(0.200, -0.400),
    vec2(0.300, -0.100), vec2(0.100, 0.300), vec2(-0.300, 0.100), vec2(-0.100, -0.300),
    vec2(0.469, 0.350), vec2(-0.350, 0.469), vec2(-0.469, -0.350), vec2(0.350, -0.469),
    vec2(-0.050, 0.250), vec2(-0.250, -0.050), vec2(0.050, -0.250), vec2(0.250, 0.050),
    vec2(0.425, 0.030), vec2(-0.030, 0.425), vec2(-0.425, -0.030), vec2(0.030, -0.425),
    vec2(-0.311, 0.280), vec2(-0.280, -0.311), vec2(0.311, -0.280), vec2(0.280, 0.311),
    vec2(0.136, -0.113), vec2(0.113, 0.136), vec2(-0.136, 0.113), vec2(-0.113, -0.136),
    vec2(-0.442, 0.169), vec2(-0.169, -0.442), vec2(0.442, -0.169), vec2(0.169, 0.442));
#if TC_TEXT_C4_SCHEDULE == 0
const int textC4LevelSizes[] = int[](1,5,9,13,17,21,25,29,33);
const vec2 textC4Bands[] = vec2[](
    vec2(1.0,1.125), vec2(1.125,32.0),
    vec2(32.0,45.25), vec2(45.25,64.0),
    vec2(64.0,76.1), vec2(76.1,90.5),
    vec2(90.5,107.6), vec2(107.6,128.0));
#else
const int textC4LevelSizes[] = int[](1,5,9,17,33);
#if TC_TEXT_C4_SCHEDULE == 1
const vec2 textC4Bands[] = vec2[](
    vec2(1.0,1.125), vec2(32.0,36.0),
    vec2(64.0,72.0), vec2(128.0,144.0));
#else
const vec2 textC4Bands[] = vec2[](
    vec2(1.0,1.125), vec2(1.125,32.0),
    vec2(32.0,64.0), vec2(64.0,128.0));
#endif
#endif

float textCoverage(vec2 uv) {
    vec2 dx = dFdx(uv);
    vec2 dy = dFdy(uv);
    vec2 size = vec2(textureSize(sampler2D(tex, smp), 0));
    float rho = max(length(dx * size), length(dy * size));
    float sum = textureGrad(sampler2D(tex, smp), uv, dx * .5, dy * .5).r;
    if (rho <= textC4Bands[0].x) return sum;
    float totalWeight = 1.0;
    for (int group = 0; group < textC4Bands.length(); ++group) {
        int first = textC4LevelSizes[group];
        int end = textC4LevelSizes[group + 1];
        if (end > TC_TEXT_TOP) break;
        vec2 band = textC4Bands[group];
        if (rho <= band.x) break;
        float w = clamp(log2(rho / band.x) / log2(band.y / band.x), 0.0, 1.0);
        for (int i = first; i < end; ++i) {
            vec2 offset = textC4Offsets[i];
            sum += w * textureGrad(sampler2D(tex, smp), uv + dx * offset.x - dy * offset.y, dx * .5, dy * .5).r;
        }
        totalWeight += float(end - first) * w;
        if (rho < band.y) break;
    }
    return sum / totalWeight;
}
#else
// The nested top comes from the arrays; TC_TEXT_TAPS selects the MSAA top.
// Offsets below are supplied in target pixels with Y down; sampling flips Y.
#if TC_TEXT_PATTERN == 2
const vec2 textNestedOffsets[] = vec2[](
    vec2(0,0), vec2(.2,.4), vec2(-.4,.2), vec2(-.2,-.4), vec2(.4,-.2));
const int textLevelSizes[] = int[](1,5);
const float textNestedThresholds[] = float[](1.0);
#else
const vec2 textNestedOffsets[] = vec2[](
    vec2(0,0), vec2(.103,.397), vec2(.397,.103), vec2(-.500,-.500),
    vec2(.052,-.300), vec2(-.300,.052), vec2(.448,-.200), vec2(-.200,.448),
    vec2(.222,-.089), vec2(.169,.162), vec2(-.072,.237), vec2(.264,-.415),
    vec2(-.338,-.335), vec2(.345,.329), vec2(-.162,-.164), vec2(-.428,.275));
const int textLevelSizes[] = int[](1,4,8,16);
const float textNestedThresholds[] = float[](1.0,32.0,64.0);
#endif

float textCoverage(vec2 uv) {
    vec2 dx = dFdx(uv);
    vec2 dy = dFdy(uv);
    vec2 size = vec2(textureSize(sampler2D(tex, smp), 0));
    float rho = max(length(dx * size), length(dy * size));
    // Preserve the exact single sample at 1:1 and magnification.
    if (rho <= textNestedThresholds[0])
        return textureGrad(sampler2D(tex, smp), uv, dx * .5, dy * .5).r;
    int count = 1;
    int oldCount = 1;
    float w = 1.0;
    for (int level = 0; level < textNestedThresholds.length(); ++level) {
        oldCount = textLevelSizes[level];
        float threshold = textNestedThresholds[level];
        if (rho <= threshold) {
            count = oldCount;
            w = 1.0;
            break;
        }
        count = textLevelSizes[level + 1];
        w = clamp((rho / threshold - 1.0) * 8.0, 0.0, 1.0);
        if (rho < threshold * 1.125) break;
    }
    float sum = 0.0;
    for (int i = 0; i < count; ++i) {
        vec2 offset = textNestedOffsets[i];
        float weight = i < oldCount ? 1.0 : w;
        sum += weight * textureGrad(sampler2D(tex, smp), uv + dx * offset.x - dy * offset.y, dx * .5, dy * .5).r;
    }
    return sum / (float(oldCount) + float(count - oldCount) * w);
}
#endif
@end
