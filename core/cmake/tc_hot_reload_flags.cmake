include_guard(GLOBAL)

# Run at the end of the app directory, after local.cmake and other targets.
# Subdirectories (core/addons) already inherited the original flags. Moving
# only optimization/debug-format options to app targets keeps guest sources
# in the app directory without /O2 /Od overrides (MSVC D9025). The cache stays
# untouched, so another configure starts with the user's original settings.
function(tc_hot_reload_flags)
    get_property(_tc_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    get_cmake_property(_tc_variables VARIABLES)
    set(_tc_host_compile "")
    set(_tc_host_link "")
    foreach(_tc_variable IN LISTS _tc_variables)
        if(NOT _tc_variable MATCHES "^CMAKE_(C|CXX|OBJC|OBJCXX)_FLAGS($|_(.+))")
            continue()
        endif()
        set(_tc_language "${CMAKE_MATCH_1}")
        set(_tc_config "${CMAKE_MATCH_3}")
        set(_tc_flags "${${_tc_variable}}")
        if(MSVC)
            # Embed guest debug info: a debugger can lock its compiler PDB.
            set(_tc_pattern "[-/]O[12xd]|/Z[iI]")
        else()
            set(_tc_pattern "-O([0-9]+|g|s|z|fast)?")
        endif()
        set(_tc_options "")
        while(_tc_flags MATCHES "(^|[ \t])(${_tc_pattern})([ \t]|$)")
            set(_tc_match "${CMAKE_MATCH_0}")
            list(APPEND _tc_options "${CMAKE_MATCH_2}")
            # Remove the first match only, preserving option order/duplicates
            # for the host.
            string(FIND "${_tc_flags}" "${_tc_match}" _tc_start)
            string(LENGTH "${_tc_match}" _tc_length)
            math(EXPR _tc_end "${_tc_start} + ${_tc_length}")
            string(SUBSTRING "${_tc_flags}" 0 ${_tc_start} _tc_before)
            string(SUBSTRING "${_tc_flags}" ${_tc_end} -1 _tc_after)
            set(_tc_flags "${_tc_before} ${_tc_after}")
        endwhile()
        set(${_tc_variable} "${_tc_flags}" PARENT_SCOPE)
        if(_tc_options)
            # SHELL keeps repeated options in their original order instead of
            # CMake de-duplicating a later configuration's optimization level.
            list(JOIN _tc_options " " _tc_options)
            set(_tc_compile "$<COMPILE_LANGUAGE:${_tc_language}>")
            set(_tc_link "$<LINK_LANGUAGE:${_tc_language}>")
            if(NOT _tc_config STREQUAL "")
                set(_tc_compile "$<AND:${_tc_compile},$<CONFIG:${_tc_config}>>")
                set(_tc_link "$<AND:${_tc_link},$<CONFIG:${_tc_config}>>")
            endif()
            list(APPEND _tc_host_compile "$<${_tc_compile}:SHELL:${_tc_options}>")
            list(APPEND _tc_host_link "$<${_tc_link}:SHELL:${_tc_options}>")
        endif()
    endforeach()
    foreach(_tc_target IN LISTS _tc_targets)
        get_target_property(_tc_type ${_tc_target} TYPE)
        if(_tc_target STREQUAL "guest" OR _tc_type MATCHES "^(INTERFACE_LIBRARY|UTILITY)$")
            continue()
        endif()
        # Configured flags originally preceded any target-specific options.
        target_compile_options(${_tc_target} BEFORE PRIVATE ${_tc_host_compile})
        if(_tc_type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
            target_link_options(${_tc_target} BEFORE PRIVATE ${_tc_host_link})
        endif()
    endforeach()
endfunction()
