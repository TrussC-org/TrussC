# Stage plain data files and a content-based build id for Android startup.
file(REMOVE_RECURSE "${ASSETS_DIR}")
file(MAKE_DIRECTORY "${ASSETS_DIR}")
file(GLOB_RECURSE data_files FOLLOW_SYMLINKS LIST_DIRECTORIES false RELATIVE "${DATA_DIR}" "${DATA_DIR}/*")
list(FILTER data_files EXCLUDE REGEX "(^|/)(\\.[^/]*|[^/]*~)(/|$)")
list(SORT data_files)
if("${data_files}" STREQUAL "")
    return()
endif()
set(file_list "")
set(fingerprints "")
foreach(relative IN LISTS data_files)
    if(relative MATCHES "[\r\n]")
        message(FATAL_ERROR "Android data filenames cannot contain line breaks: ${relative}")
    endif()
    get_filename_component(parent "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${ASSETS_DIR}/data/${parent}")
    configure_file("${DATA_DIR}/${relative}" "${ASSETS_DIR}/data/${relative}" COPYONLY)
    file(SHA256 "${ASSETS_DIR}/data/${relative}" digest)
    string(APPEND fingerprints "${relative}\n${digest}\n")
    string(APPEND file_list "${relative}\n")
endforeach()
string(SHA256 build_id "${fingerprints}")
file(WRITE "${ASSETS_DIR}/trussc-data.manifest" "${build_id}\n${file_list}")
