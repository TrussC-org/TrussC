include("${CMAKE_CURRENT_LIST_DIR}/tc_shared_build.cmake")
tc_shared_build_read_owner("${TC_SHARED_STAMP}" owner)
if("${owner}" STREQUAL "${TC_SHARED_OWNER}")
    return()
endif()

# Retain a mismatched owner so a failed timestamp advance cannot accept stale
# shared rules. Rewrite oversized/missing metadata with the bounded value.
file(WRITE "${TC_SHARED_STAMP}" "${owner}")
# Makefile generators use these configure/generate outputs.
file(GLOB outputs
    "${TC_SHARED_OWNER}/Makefile"
    "${TC_SHARED_OWNER}/CMakeFiles/cmake.check_cache")
# IS_NEWER_THAN includes equality: invert the comparison for strict freshness.
# Bound (platform): a coarse filesystem clock gets at most 5 s (50 x 0.1 s) to advance. Overflow still fails this build with the hint below, and the stale rules stay blocked.
foreach(attempt RANGE 0 50)
    set(newer TRUE)
    foreach(output IN LISTS outputs)
        if("${output}" IS_NEWER_THAN "${TC_SHARED_STAMP}")
            set(newer FALSE)
        endif()
    endforeach()
    if(newer OR attempt EQUAL 50)
        break()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.1)
    file(TOUCH "${TC_SHARED_STAMP}")
endforeach()

get_filename_component(shared_directory "${TC_SHARED_STAMP}" DIRECTORY)
get_filename_component(shared_name "${shared_directory}" NAME)
# Indent the hint so CMake preserves it as one line instead of wrapping it.
message(FATAL_ERROR
    " TrussC: core/${shared_name} was regenerated by another app; build again to reconfigure (#885)")
